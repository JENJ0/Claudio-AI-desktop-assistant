{
  "permissions": {
    "deny": [
      "Read(./models/**)",
      "Read(**/*.wav)",
      "Read(./uv.lock)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "brightdata-plugin@synced": false,
    "cowork-plugin-management@synced": false,
    "data@synced": false,
    "design@synced": false,
    "engineering@synced": false,
    "productivity@synced": false
  }
}
