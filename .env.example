# Copy this file to `.env` (same folder, next to pyproject.toml) and fill in your values.
# `.env` is in .gitignore: it never goes to GitHub. Never paste the key in a chat or in the code.

# Claude API key from https://console.anthropic.com (Settings > API keys). Needs prepaid credit:
# the Claude Pro subscription does not include the API.
ANTHROPIC_API_KEY=

# Any setting in config/claudio.toml can be overridden here, e.g.:
# CLAUDIO_STT__DEVICE=cpu
# CLAUDIO_LOGGING__LEVEL=DEBUG
# CLAUDIO_CLAUDE__ENABLED=false
# CLAUDIO_COST__DAILY_BUDGET=0.5
